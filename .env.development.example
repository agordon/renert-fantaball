# Development configuration - copy this file to ".env"
#
# Every FLASK_XXX variable becomes app.config["XXX"].
# Values are parsed as JSON when possible (true/false/numbers), otherwise kept as strings.
# Variables already set in the shell environment take priority over this file.

# Required (the app will not start without them)

# "development" or "production" - NOT the same as debug mode (which could be turned on in production).
# Only "development" loads the sample data from models/init_data.py.
FLASK_ENVIRONMENT="development"
FLASK_SITE_NAME="Project Name (dev)"

# Relative SQLite paths are stored in the "instance/" directory
FLASK_SQLALCHEMY_DATABASE_URI="sqlite:///database.db"

# Flask debug mode (auto-reloader, debugger, and enables the fake user below)
FLASK_DEBUG=true

# See flask_jwt_auth_manager.py:
# When not behind a proxy (no "X-Forwarded-For" header, e.g. running on 127.0.0.1),
# pretend this user is logged in, instead of requiring a JWT from OAuth2-Proxy.
FLASK_JWT_AUTH_DUMMY_USER_IF_NO_PROXY=true
FLASK_JWT_AUTH_DUMMY_USER_EMAIL="john.doe@example.com"
FLASK_JWT_AUTH_DUMMY_USER_FIRST_NAME="John"
FLASK_JWT_AUTH_DUMMY_USER_LAST_NAME="Doe"

# Log the decoded JWT / fake user details on every request
FLASK_JWT_AUTH_DEBUG=true
