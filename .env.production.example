# Production configuration - copy this file to ".env" on the server
#
# Every FLASK_XXX variable becomes app.config["XXX"].
# Values are parsed as JSON when possible (true/false/numbers), otherwise kept as strings.
# Variables already set in the shell environment take priority over this file.

# Required (the app will not start without them)

# "development" or "production" - NOT the same as debug mode (which could be turned on in production).
# Only "development" loads the sample data from models/init_data.py.
FLASK_ENVIRONMENT="production"
FLASK_SITE_NAME="Project Name"

# Relative SQLite paths are stored in the "instance/" directory
FLASK_SQLALCHEMY_DATABASE_URI="sqlite:///database.db"

# Never run production with debug mode
FLASK_DEBUG=false

# See flask_jwt_auth_manager.py:
# Users are authenticated by NGINX + OAuth2-Proxy, which pass a JWT in the
# "Authorization" request header. The fake development user MUST stay disabled -
# it is set explicitly here (rather than relying on the default, which follows DEBUG).
FLASK_JWT_AUTH_DUMMY_USER_IF_NO_PROXY=false
FLASK_JWT_AUTH_DEBUG=false

# ---------------------------------------------------------------------------------------------
# FantaBall: NBA data pipeline (see README "Real NBA data")
# ---------------------------------------------------------------------------------------------
# Real data comes from Highlightly (https://highlightly.net/). The FREE plan needs no credit card: 100 requests/day, and it
# includes player stats and box scores. Create an account, then copy your API key into .env (git-ignored).
# NEVER commit the real key; this file only holds a placeholder. The key is never sent to the browser.
HIGHLIGHTLY_API_KEY=your_highlightly_api_key_here
# Requests per day your plan allows (the app stops before using more) and a polite per-minute pace.
HIGHLIGHTLY_DAILY_QUOTA=100
HIGHLIGHTLY_REQUESTS_PER_MINUTE=10

# "highlightly" (default) or "balldontlie" (free plan has no player stats; ALL-STAR plan needed for those)
FLASK_NBA_PROVIDER="highlightly"
# BALLDONTLIE_API_KEY=your_balldontlie_api_key_here
# Season start year (2026 = the 2026-27 season). Leave unset to use the current season.
# FLASK_NBA_SEASON=2026
# Monday that counts as "day 1" of the regular season (set it if the provider also lists preseason games)
# FLASK_NBA_SEASON_START=2026-10-19

# Who may use the Data Administration page (JSON list of login emails)
FLASK_ADMIN_EMAILS='["administrator@example.com"]'
